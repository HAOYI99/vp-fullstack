# Central reference for workspace environment variables.
# For local dev, copy to respective app directories:
#   cp apps/api/.env.example apps/api/.env
#   cp apps/web/.env.example apps/web/.env

# API (apps/api/.env)
PORT=3000
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_SSL=false
SUPABASE_URL=http://localhost:54321
SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder
SUPABASE_SECRET_KEY=sb_secret_placeholder

# Web (apps/web/.env)
VITE_APP_TITLE="VitePlus Full Stack"
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder
VITE_API_URL=http://localhost:3000
