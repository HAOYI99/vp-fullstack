PORT=3000
CORS_ORIGIN=http://localhost:5173

# Postgres direct connection for Drizzle ORM
# Local: postgresql://postgres:postgres@localhost:54322/postgres (DATABASE_SSL="false")
# Prod/Cloud: DATABASE_SSL="true", use connection pooling string from Supabase/Neon
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_SSL=false

# Supabase Auth / Storage
# Local: http://localhost:54321 | Prod: https://<project-ref>.supabase.co
SUPABASE_URL=http://localhost:54321
SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder
# Server-only secret key (service role). Never expose to frontend!
SUPABASE_SECRET_KEY=sb_secret_placeholder
