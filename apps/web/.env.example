# App branding title
VITE_APP_TITLE="VitePlus Full Stack"

# Point to Supabase (Local: http://localhost:54321 | Prod: https://<project-ref>.supabase.co)
VITE_SUPABASE_URL=http://localhost:54321

# Public/anon key from Supabase Dashboard
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder

# Backend API server URL (Local: http://localhost:3000 | Prod: https://api.yourdomain.com)
VITE_API_URL=http://localhost:3000
